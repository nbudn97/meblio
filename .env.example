# Meblio configuration example. Copy to .env and adjust.
# Real environment variables take precedence over .env values.

# HTTP port (default 8000) and WebSocket port (default 8001)
#PORT=8000
#WS_PORT=8001

# Public host used for canonical/sitemap/robots (SEO).
# In production set it to your domain (e.g. meblio.example.com).
# Default: Host request header, fallback meblio.local.
# Email links always use the request Host + X-Forwarded-Proto.
#MEBLIO_HOST=meblio.example.com

# Public scheme override (http/https). Normally taken from X-Forwarded-Proto.
#MEBLIO_SCHEME=https

# Database and uploads locations (defaults: ./meblio.db, ./uploads)
#MEBLIO_DB=F:\AI_work\Meblio\meblio.db
#MEBLIO_UPLOADS=F:\AI_work\Meblio\uploads

# Development mode: include verification/reset links in API responses (1/0).
# Default is 0 (links are NOT leaked in API responses) — keep unset in production.
#MEBLIO_DEV=1

# SMTP for real email delivery (verification, password reset). Empty = mock to log only.
#SMTP_HOST=smtp.example.com
#SMTP_PORT=587
#SMTP_USER=noreply@example.com
#SMTP_PASSWORD=secret
#SMTP_FROM=noreply@example.com

# AI assistant (any OpenAI-compatible chat completions API).
# Empty AI_API_KEY = built-in offline assistant (rule-based, DB-grounded).
#AI_API_KEY=
#AI_BASE_URL=https://api.openai.com/v1
#AI_MODEL=gpt-4o-mini
